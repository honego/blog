---
import FormattedDate from "@components/FormattedDate.astro";
import SiteLayout from "./SiteLayout.astro";

type Props = {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  readingTime: { words: number; minutes: number };
};

const { title, description, date, updated, readingTime } = Astro.props;
---

<SiteLayout title={title} description={description} type="article" publishedTime={date}>
  <header class="post-header">
    <h1>{title}</h1>
    <div class="post-date">
      <FormattedDate date={date} />
      <span> · 约 {readingTime.words.toLocaleString("zh-CN")} 字 · 预计阅读 {readingTime.minutes} 分钟</span>
      {
        updated && (
          <span>
            {" "}
            · updated <FormattedDate date={updated} />
          </span>
        )
      }
    </div>
  </header>
  <article class="prose post-content">
    <slot />
  </article>
</SiteLayout>

<style>
  .post-header {
    margin-bottom: 2.5rem;
  }

  h1 {
    margin: 0;
    color: var(--color-text-strong);
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 2rem;
  }

  .post-date {
    margin-top: 0.5em;
    color: var(--color-text-faint);
    font-variant-numeric: tabular-nums;
    line-height: 1.25rem;
  }
</style>

<script>
  import "../scripts/copy-code";
</script>

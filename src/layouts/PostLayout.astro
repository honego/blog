---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";
import SiteLayout from "./SiteLayout.astro";

type Props = {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  readingTime: { words: number; minutes: number };
  tags: string[];
  nextPost?: CollectionEntry<"posts">;
};

const { title, description, date, updated, readingTime, tags, nextPost } = Astro.props;
---

<SiteLayout title={title} description={description} type="article" publishedTime={date}>
  <header class="post-header">
    <h1>{title}</h1>
    <div class="post-date">
      <FormattedDate date={date} />
      <span> · 约 {readingTime.words.toLocaleString("zh-CN")} 字 · 预计阅读 {readingTime.minutes} 分钟</span>
      {
        tags.length > 0 && (
          <span>
            {" "}
            ·
            {tags.map((tag) => (
              <a href={`/tags/${encodeURIComponent(tag)}`}> #{tag}</a>
            ))}
          </span>
        )
      }
      {
        updated && (
          <span>
            {" "}
            · updated <FormattedDate date={updated} />
          </span>
        )
      }
    </div>
  </header>
  <article class="prose prose-neutral max-w-none post-content dark:prose-invert">
    <slot />
  </article>
  {
    nextPost && (
      <nav class="next-post" aria-label="下一篇">
        <p>下一篇</p>
        <h2>
          <a href={`/${nextPost.data.id}.html`}>{nextPost.data.title}</a>
        </h2>
        <p>{nextPost.data.description}</p>
      </nav>
    )
  }
</SiteLayout>

<style>
  .post-header {
    margin-bottom: 2.5rem;
  }

  h1 {
    margin: 0;
    color: var(--color-text-strong);
    font-size: 2rem;
    font-weight: 600;
    line-height: 2.5rem;
  }

  .post-date {
    margin-top: 0.25em;
    color: var(--color-text-faint);
    font-variant-numeric: tabular-nums;
    line-height: 1.25rem;
  }

  .post-date a {
    color: inherit;
    text-decoration: none;
  }

  .post-date a:hover {
    color: var(--color-text);
  }

  .next-post {
    margin-top: 3.5rem;
  }

  .next-post p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .next-post p:first-child {
    color: var(--color-text-faint);
  }

  .next-post h2 {
    margin: 0;
    padding-block: 0.5rem;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.5rem;
  }

  .next-post a {
    color: inherit;
    text-decoration: none;
  }

  .next-post a:hover {
    text-decoration: underline;
  }
</style>

<script>
  import "../scripts/copy-code";
</script>

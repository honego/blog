---
import { Font } from "astro:assets";
import Head from "@components/Head.astro";
import SearchDialog from "@components/SearchDialog.astro";
import SiteHeader from "@components/SiteHeader.astro";
import SiteFooter from "@components/SiteFooter.astro";
import { SITE } from "../config";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: Date;
};

const { title, description, type, publishedTime } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <Head title={title} description={description} type={type} publishedTime={publishedTime} />
    <Font cssVariable="--font-serif" preload={[{ subset: "latin" }]} />
    <style is:inline>
      .site-shell {
        width: min(100%, 50rem);
        margin-inline: auto;
      }
    </style>
  </head>
  <body>
    <div class="top-fade" aria-hidden="true"></div>
    <div class="site-shell">
      <SiteHeader />
      <main id="main-content" class="content-panel">
        <div class="page-content">
          <slot />
        </div>
      </main>
    </div>
    <SiteFooter />
    <SearchDialog />
  </body>
</html>

<script>
  import mediumZoom from "medium-zoom";

  mediumZoom("#main-content img", {
    margin: 24,
    background: "color-mix(in srgb, var(--color-background) 96%, transparent)",
  });
</script>

---
import Head from "@components/Head.astro";
import SideNav from "@components/SideNav.astro";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  wide?: boolean;
  type?: "website" | "article";
  publishedTime?: Date;
};

const { title, description, wide = false, type, publishedTime } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} type={type} publishedTime={publishedTime} />
  </head>
  <body>
    <div class="top-fade" aria-hidden="true"></div>
    <div class:list={["site-shell", { "site-shell--wide": wide }]}>
      <SideNav />
      <main id="main-content" class="content-panel">
        <div class="page-content">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>

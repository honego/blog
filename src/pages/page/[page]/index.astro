---
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Pagination from "@components/Pagination.astro";
import PostList from "@components/PostList.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { POSTS_PER_PAGE } from "../../../config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return paginate(posts, { pageSize: POSTS_PER_PAGE }).filter(({ props }) => props.page.currentPage > 1);
}) satisfies GetStaticPaths;

type Props = { page: Page<CollectionEntry<"posts">> };

const { page } = Astro.props;
const prev = page.currentPage === 2 ? "/" : page.url.prev;
---

<SiteLayout title={`第 ${page.currentPage} 页`}>
  <h1 class="visually-hidden">Blog</h1>
  <PostList entries={page.data} />
  <Pagination currentPage={page.currentPage} lastPage={page.lastPage} {prev} next={page.url.next} />
</SiteLayout>

---
import Pagination from "@components/Pagination.astro";
import PostList from "@components/PostList.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { getPublishedPosts } from "@lib/posts";
import { POSTS_PER_PAGE } from "../config";

// 首页只截取首屏数据, 全部公开文章仍由共享查询完整返回
const posts = await getPublishedPosts();
const lastPage = Math.ceil(posts.length / POSTS_PER_PAGE);
const entries = posts.slice(0, POSTS_PER_PAGE);
---

<SiteLayout>
  <h1 class="visually-hidden">Blog</h1>
  {entries.length > 0 ? <PostList {entries} /> : <p>No published posts yet.</p>}
  {lastPage > 1 && <Pagination currentPage={1} {lastPage} next="/page/2" />}
</SiteLayout>

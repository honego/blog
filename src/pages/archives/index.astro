---
import { render } from "astro:content";
import SiteLayout from "@layouts/SiteLayout.astro";
import { getPostHref, getPublishedPosts } from "@lib/posts";

// 归档仅复用全站文章规则, 年份分组和字数统计仍由本页面负责
const posts = await getPublishedPosts();
const archiveEntries = await Promise.all(
  posts.map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post);

    return { post, words: remarkPluginFrontmatter.readingTime.words };
  }),
);
const totalWords = archiveEntries.reduce((total, { words }) => total + words, 0);
const postsByYear = new Map<number, typeof archiveEntries>();

for (const entry of archiveEntries) {
  const year = entry.post.data.date.getUTCFullYear();
  const entries = postsByYear.get(year);

  if (entries) {
    entries.push(entry);
  } else {
    postsByYear.set(year, [entry]);
  }
}

const years = [...postsByYear].sort(([a], [b]) => b - a);
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "2-digit",
  timeZone: "UTC",
});
---

<SiteLayout title="归档" description="博客文章归档。">
  <h1 class="visually-hidden">归档</h1>
  <p class="summary">共 {archiveEntries.length} 篇文章，约 {totalWords.toLocaleString("en-US")} 字。</p>
  {
    years.map(([year, entries]) => (
      <section>
        <h2>{year}</h2>
        <ul>
          {entries.map(({ post }) => (
            <li>
              <a href={getPostHref(post.data.id)}>{post.data.title}</a>
              <time datetime={post.data.date.toISOString()}>{dateFormatter.format(post.data.date)}</time>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</SiteLayout>

<style>
  .summary {
    margin-block: 0 2rem;
    color: var(--color-text-muted);
  }

  section + section {
    margin-block-start: 2rem;
  }

  h2 {
    margin-block: 0 0.5rem; /* 年份标题顶部不额外留白, 底部保留 8px, 与下面的文章列表拉开适度距离 */
    color: var(--color-text-strong); /* 使用全局强调文本颜色, 保证 Light / Dark Theme 下都能保持足够的视觉层级 */
    font-size: 1.0625rem; /* 17px, 与首页文章标题字号保持一致, 避免年份标题过大, 抢占页面视觉重点 */
    font-weight: 600; /* 使用 Semi Bold 级别字重, 让年份比普通正文更醒目, 但不会像 700 Bold 那样过重 */
    line-height: 1.5rem; /* 24px, 在 17px 字号下保持紧凑但不拥挤的行高, 与首页标题的垂直节奏一致 */
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.25rem;
  }

  a {
    min-inline-size: 0;
    color: var(--color-text);
    text-decoration: none;
    transition: color 160ms ease;
  }

  a:hover,
  a:focus-visible {
    color: var(--color-text-strong);
  }

  a:focus-visible {
    border-radius: 0.15rem;
    outline: 1px dotted var(--color-text-muted);
    outline-offset: 2px;
  }

  time {
    flex: none;
    margin-inline-start: auto;
    color: var(--color-text-faint);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.25rem;
    white-space: nowrap;
  }
</style>

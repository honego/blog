---
import SiteLayout from "@layouts/SiteLayout.astro";
---

<SiteLayout title="Images" description="A growing collection of photographs and visual notes.">
  <h1 class="page-title">Images</h1>
  <p class="empty-state">The image collection is taking shape.</p>
</SiteLayout>

<style>
  .empty-state {
    margin: 0;
    color: var(--color-text-faint);
    font-family: var(--font-serif);
    font-style: italic;
  }
</style>

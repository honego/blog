---
import { getCollection } from "astro:content";
import ArticleList from "@components/ArticleList.astro";
import SiteLayout from "@layouts/SiteLayout.astro";

const thoughts = (await getCollection("thoughts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<SiteLayout title="Thoughts" description="Writing about web infrastructure, open source, and software craft.">
  <h1 class="page-title">Thoughts</h1>
  {thoughts.length > 0 ? <ArticleList entries={thoughts} /> : <p>No published notes yet.</p>}
</SiteLayout>

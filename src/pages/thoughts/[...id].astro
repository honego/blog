---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import ArticleLayout from "@layouts/ArticleLayout.astro";

export async function getStaticPaths() {
  const thoughts = await getCollection("thoughts", ({ data }) => !data.draft);

  return thoughts.map((thought) => ({
    params: { id: thought.id },
    props: { thought },
  }));
}

type Props = {
  thought: CollectionEntry<"thoughts">;
};

const { thought } = Astro.props;
const { Content } = await render(thought);
---

<ArticleLayout
  title={thought.data.title}
  description={thought.data.description}
  date={thought.data.date}
  updated={thought.data.updated}
>
  <Content />
</ArticleLayout>

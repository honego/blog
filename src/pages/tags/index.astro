---
import { getCollection } from "astro:content";
import SiteLayout from "@layouts/SiteLayout.astro";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const tagCounts = posts
  .flatMap(({ data }) => data.tags)
  .reduce((counts, tag) => counts.set(tag, (counts.get(tag) ?? 0) + 1), new Map<string, number>());
const tags = [...tagCounts].sort(([a], [b]) => (a > b ? 1 : a < b ? -1 : 0));
const counts = tags.map(([, count]) => count);
const uniqueCounts = [...new Set(counts)].sort((a, b) => a - b);
const minCount = Math.min(...counts);
const countRange = Math.max(Math.max(...counts) - minCount, 1);
---

<SiteLayout title="Tags" description="Browse posts by tag.">
  <h1 class="visually-hidden">Tags</h1>
  {
    tags.length > 0 ? (
      <ul class="tag-list">
        {tags.map(([tag, count]) => {
          const weight = (count - minCount) / countRange;
          const sizeWeight = uniqueCounts.length > 1 ? uniqueCounts.indexOf(count) / (uniqueCounts.length - 1) : 0;
          const fontSize = 1 + sizeWeight * 0.5;
          return (
            <li>
              <a
                href={`/tags/${tag}`}
                style={`font-size: ${fontSize.toFixed(2)}rem; color: color-mix(in srgb, var(--color-text-faint), var(--color-text-strong) ${Math.round(weight * 100)}%)`}
              >
                {tag}
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <p>No tags yet.</p>
    )
  }
</SiteLayout>

<style>
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list a {
    display: block;
    padding: 0.9375rem;
    line-height: 1;
    text-decoration: none;
    transition: opacity 300ms ease-in-out;
  }

  .tag-list a:hover {
    opacity: 0.65;
  }
</style>

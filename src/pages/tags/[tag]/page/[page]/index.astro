---
import type { GetStaticPaths, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Pagination from "@components/Pagination.astro";
import PostList from "@components/PostList.astro";
import SiteLayout from "@layouts/SiteLayout.astro";
import { getPublishedPosts } from "@lib/posts";
import { POSTS_PER_PAGE } from "../../../../../config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap(({ data }) => data.tags))];

  return tags.flatMap((tag) =>
    paginate(
      posts.filter(({ data }) => data.tags.includes(tag)),
      {
        pageSize: POSTS_PER_PAGE,
        params: { tag },
        props: { tag },
      },
    ).filter(({ props }) => props.page.currentPage > 1),
  );
}) satisfies GetStaticPaths;

type Props = {
  tag: string;
  page: Page<CollectionEntry<"posts">>;
};

const { tag, page } = Astro.props;
const tagHref = `/tags/${encodeURIComponent(tag)}`;
const prev = page.currentPage === 2 ? tagHref : page.url.prev;
---

<SiteLayout title={`${tag} · 第 ${page.currentPage} 页`} description={`标签「${tag}」下的博客文章。`}>
  <h1>{tag}</h1>
  <PostList entries={page.data} />
  <Pagination currentPage={page.currentPage} lastPage={page.lastPage} {prev} next={page.url.next} />
</SiteLayout>

<style>
  h1 {
    margin-block: 0 1.75rem;
    color: var(--color-text-strong);
    font-size: inherit;
    font-weight: 620;
  }
</style>

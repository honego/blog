---
import { ANALYTICS, SITE } from "../config";

type Props = {
  title?: string;
  description?: string;
  type?: "website" | "article";
  publishedTime?: Date;
};

const { title = SITE.title, description = SITE.description, type = "website", publishedTime } = Astro.props;
const pageTitle = title === SITE.title ? `${title} | ${SITE.description}` : `${title} | ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const openGraphImage = new URL("/open-graph.png", Astro.site ?? Astro.url);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#fcfcfc" />
<script is:inline>
  (() => {
    const themeKey = "theme";
    let storedTheme = null;

    try {
      storedTheme = localStorage.getItem(themeKey);
    } catch {}

    const prefersDark = window.matchMedia?.("(prefers-color-scheme: dark)").matches;
    const theme = ["light", "dark"].includes(storedTheme) ? storedTheme : prefersDark ? "dark" : "light";

    document.documentElement.dataset.theme = theme;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute("content", theme === "dark" ? "#1a1a1a" : "#fcfcfc");
  })();
</script>
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />

<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href="/rss.xml" />
<link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={openGraphImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content="" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={openGraphImage} />
<meta name="twitter:image:alt" content="" />

{ANALYTICS && <script is:inline defer src={ANALYTICS.src} data-website-id={ANALYTICS.websiteId} />}

<title>{pageTitle}</title>

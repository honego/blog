---
type Props = {
  currentPage: number;
  lastPage: number;
  prev?: string;
  next?: string;
};

const { currentPage, lastPage, prev, next } = Astro.props;
---

<nav class="pagination" aria-label="分页导航">
  <ul>
    <li class="prev">{prev && <a href={prev}>{"< Prev"}</a>}</li>
    <li class="current">{currentPage} of {lastPage}</li>
    <li class="next">{next && <a href={next}>{"Next >"}</a>}</li>
  </ul>
</nav>

<style>
  .pagination {
    margin-top: 3.5rem;
    font-size: 1rem;
    line-height: 1.5rem;
  }

  .pagination ul {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .prev {
    text-align: left;
  }

  .current {
    color: var(--color-text-faint);
    text-align: center;
  }

  .next {
    text-align: right;
  }

  .pagination a {
    color: var(--color-text-strong);
    text-decoration: none;
  }

  .pagination a:is(:hover, :focus-visible) {
    text-decoration: underline;
  }
</style>

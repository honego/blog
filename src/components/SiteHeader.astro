---
import SiteActions from "@components/SiteActions.astro";
import { NAV_ITEMS, SITE } from "../config";
---

<header class="site-header">
  <a class="site-brand" href="/">
    <img src="/favicon.png" alt="" width="32" height="32" />
    <span>{SITE.title}</span>
  </a>
  <nav aria-label="Primary navigation">
    <ul>
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <SiteActions />
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: -0.75rem;
    margin-bottom: 3rem;
  }

  .site-brand {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-text-strong);
    font-family:
      -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, Roboto, "PingFang SC", "Hiragino Sans GB",
      "Source Han Sans SC", "Noto Sans CJK SC", "Noto Sans SC", "WenQuanYi Micro Hei", "WenQuanYi Zen Hei",
      "Helvetica Neue", "Microsoft YaHei", Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji",
      "Segoe UI Symbol";
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.5px;
    text-decoration: none;
    text-transform: none;
    white-space: nowrap;
  }

  .site-brand img {
    display: block;
    border-radius: 0.375rem;
  }

  nav {
    min-width: 0;
  }

  ul {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.25rem 0.9375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    color: var(--color-text);
    text-decoration: none;
    text-transform: lowercase;
    transition: color 160ms ease;
  }

  a:hover,
  a:focus-visible {
    color: var(--color-text-strong);
  }

  a:focus-visible {
    border-radius: 0.15rem;
    outline: 1px dotted currentColor;
    outline-offset: 2px;
  }

  @media (max-width: 39.999rem) {
    .site-header {
      gap: clamp(0.375rem, 2vw, 0.5rem);
    }

    .site-brand {
      gap: clamp(0.25rem, 1.25vw, 0.375rem);
      font-size: clamp(0.6875rem, 3.3vw, 0.8125rem);
    }

    .site-brand img {
      width: clamp(1.5rem, 7vw, 1.75rem);
      height: clamp(1.5rem, 7vw, 1.75rem);
    }

    nav {
      font-size: clamp(0.6875rem, 3.3vw, 0.8125rem);
    }

    ul {
      column-gap: clamp(0.1875rem, 1vw, 0.5rem);
    }
  }

  @media (max-width: 26.249rem) {
    .site-header {
      margin-bottom: var(--content-gutter);
    }
  }
</style>

---
import SiteActions from "@components/SiteActions.astro";
import { NAV_ITEMS } from "../config";

const pathname = Astro.url.pathname;
const isPost = /^\/[1-9]\d*\.html$/.test(pathname);
const isActive = (href: string) =>
  href === "/" ? pathname === href || isPost : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <nav aria-label="Primary navigation">
    <ul>
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <SiteActions />
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: -0.75rem;
    margin-bottom: 3rem;
  }

  nav {
    min-width: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    color: var(--color-text-faint);
    text-decoration: none;
    text-transform: lowercase;
    transition: color 160ms ease;
  }

  a:hover,
  a:focus-visible {
    color: var(--color-text-strong);
  }

  a[aria-current="page"] {
    color: var(--color-text);
  }

  a:focus-visible {
    border-radius: 0.15rem;
    outline: 1px dotted currentColor;
    outline-offset: 2px;
  }

  @media (max-width: 26.249rem) {
    .site-header {
      align-items: flex-start;
      margin-bottom: var(--content-gutter);
    }

    ul {
      column-gap: 0.75rem;
    }
  }
</style>

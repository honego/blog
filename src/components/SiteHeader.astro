---
import SiteActions from "@components/SiteActions.astro";
import { NAV_ITEMS, SITE } from "../config";
---

<header class="site-header">
  <a class="site-brand" href="/">
    <span>{SITE.title}</span>
  </a>
  <nav aria-label="Primary navigation">
    <ul>
      {
        NAV_ITEMS.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <SiteActions />
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: calc(1rem - var(--page-padding));
    margin-bottom: 3rem;
  }

  .site-brand {
    display: inline-flex;
    flex: none;
    align-items: center;
    color: var(--color-text-strong);
    font-family: inherit;
    font-size: 1.125rem;
    font-style: italic;
    font-weight: 700;
    font-synthesis: style;
    line-height: 1.5;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: none;
    white-space: nowrap;
  }

  nav {
    min-width: 0;
  }

  ul {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.25rem 0.9375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    color: var(--color-text);
    text-decoration: none;
    text-transform: lowercase;
    transition: color 160ms ease;
  }

  a:hover,
  a:focus-visible {
    color: var(--color-text-strong);
  }

  a:focus-visible {
    border-radius: 0.15rem;
    outline: 1px dotted currentColor;
    outline-offset: 2px;
  }

  @media (max-width: 39.999rem) {
    .site-header {
      gap: clamp(0.375rem, 2vw, 0.5rem);
    }

    .site-brand {
      font-size: clamp(0.6875rem, 3.3vw, 0.8125rem);
    }

    nav {
      font-size: clamp(0.6875rem, 3.3vw, 0.8125rem);
    }

    ul {
      column-gap: clamp(0.1875rem, 1vw, 0.5rem);
    }
  }

  @media (max-width: 26.249rem) {
    .site-header {
      margin-bottom: var(--content-gutter);
    }
  }

  @media (min-width: 48rem) {
    .site-header {
      margin-top: calc(2rem - var(--page-padding));
    }
  }
</style>

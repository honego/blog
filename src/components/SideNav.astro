---
import SiteActions from "@components/SiteActions.astro";
import { NAV_ITEMS } from "../config";

const pathname = Astro.url.pathname;
const isPost = /^\/[1-9]\d*\.html$/.test(pathname);
const isActive = (href: string) =>
  href === "/" ? pathname === href || isPost : pathname === href || pathname.startsWith(`${href}/`);
---

<nav class="side-nav" aria-label="Primary navigation">
  <ul>
    {
      NAV_ITEMS.map((item) => (
        <li>
          <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
  <SiteActions />
</nav>

<style>
  .side-nav {
    flex: 0 0 var(--side-nav-width);
    margin-right: var(--content-gutter);
    font-family: "Lora Navigation", var(--font-serif);
    font-feature-settings: "calt", "cpsp", "cv01", "cv03", "cv04", "liga", "ordn", "ss03";
    font-optical-sizing: auto;
    font-style: normal;
    font-variation-settings:
      "opsz" 32,
      "wght" 480;
    font-weight: 400;
    font-variant-ligatures: contextual;
    letter-spacing: -0.006em;
  }

  ul {
    position: sticky;
    top: var(--page-padding);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: block;
    margin-inline: -0.5rem;
    padding: 0 0.5rem;
    color: var(--color-text-faint);
    text-decoration: none;
    text-transform: lowercase;
    transition: color 160ms ease;
  }

  a:hover,
  a:focus-visible {
    color: var(--color-text-strong);
  }

  a[aria-current="page"] {
    color: var(--color-text);
  }

  a:focus-visible {
    border-radius: 0.15rem;
    outline: 1px dotted currentColor;
    outline-offset: 1px;
  }

  @media (max-width: 26.249rem) {
    .side-nav {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      width: 100%;
      margin: 0 0 var(--content-gutter);
      gap: 0.75rem;
    }

    ul {
      position: static;
      flex-flow: row wrap;
      justify-content: flex-end;
      gap: 0.25rem 0.75rem;
    }
  }
</style>

---
import Moon from "@lucide/astro/icons/moon";
import Rss from "@lucide/astro/icons/rss";
import Search from "@lucide/astro/icons/search";
import Sun from "@lucide/astro/icons/sun";
import SunMoon from "@lucide/astro/icons/sun-moon";
---

<div class="site-actions">
  <button
    class="icon-button search-button"
    type="button"
    aria-label="搜索文章"
    aria-haspopup="dialog"
    aria-controls="search-dialog"
    data-search-trigger
    data-tooltip="搜索文章"
  >
    <Search class="icon" />
  </button>
  <a class="icon-button rss-link" href="/rss.xml" aria-label="RSS 订阅" data-tooltip="RSS 订阅">
    <Rss class="icon" />
  </a>
  <button
    id="theme-toggle"
    class="icon-button theme-toggle"
    type="button"
    aria-label="跟随系统"
    aria-pressed="mixed"
    data-tooltip="跟随系统"
  >
    <SunMoon class="icon icon-system" />
    <Moon class="icon icon-moon" />
    <Sun class="icon icon-sun" />
  </button>
</div>

<script>
  import "../scripts/theme";
</script>

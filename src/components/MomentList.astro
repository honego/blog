---
import { render, type CollectionEntry } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

type Props = {
  entries: CollectionEntry<"moments">[];
};

const { entries } = Astro.props;
const renderedEntries = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
---

<ol class="moment-list">
  {
    renderedEntries.map(({ entry, Content }) => (
      <li>
        <article>
          <p class="moment-meta">
            <FormattedDate date={entry.data.date} showTime />
            {entry.data.tags.map((tag) => (
              <a href={`/moments/tags/${encodeURIComponent(tag)}`}>#{tag}</a>
            ))}
          </p>
          <prose-content>
            <Content />
          </prose-content>
        </article>
      </li>
    ))
  }
</ol>

<style>
  .moment-list {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moment-list > li {
    padding: 1.5rem;
    background: var(--color-code-block-bg);
  }

  .moment-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 1rem;
    row-gap: 0.25rem;
    margin-block: 0 0.75rem;
    padding-block-end: 0.75rem;
    border-block-end: 1px solid var(--color-border);
    color: var(--color-text-faint);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.25rem;
  }

  .moment-meta a {
    color: inherit;
    text-decoration: none;
  }

  .moment-meta a:hover,
  .moment-meta a:focus-visible {
    color: var(--color-text);
  }

  .moment-list :global(prose-content p) {
    margin-block: 0 0.75rem;
  }

  .moment-list :global(prose-content > :last-child) {
    margin-block-end: 0;
  }

  .moment-list :global(prose-content img) {
    max-height: 24rem;
    object-fit: cover;
  }

  .moment-list :global([data-code-copy]) {
    display: none;
  }
</style>

---
import { FILING, SITE } from "../config";

const year = new Date().getFullYear();
const filingParts = FILING?.label.split(/(\d+)/) ?? [];
const filingHref = FILING?.href ?? "";
---

<footer class:list={["site-footer", { "site-footer--with-filing": FILING }]}>
  <span>
    © {year}{" "}{SITE.author} · <a
      href="https://creativecommons.org/licenses/by-nc-sa/4.0"
      target="_blank"
      rel="license noopener">CC BY-NC-SA 4.0</a
    >
  </span>
  {
    FILING && (
      <span>
        {filingParts.map((part) =>
          /^\d+$/.test(part) ? (
            <a href={filingHref} target="_blank" rel="noopener">
              {part}
            </a>
          ) : (
            part
          ),
        )}
      </span>
    )
  }
</footer>

<style>
  .site-footer {
    --footer-bottom-offset: max(calc(var(--page-padding) - 0.5rem), env(safe-area-inset-bottom));

    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: min(100%, 50rem);
    margin-top: auto;
    margin-inline: auto;
    padding-top: var(--page-padding);
    padding-bottom: calc(var(--footer-bottom-offset) + 0.375rem);
    color: var(--color-text-muted);
    font-size: 0.92rem;
    text-align: center;
  }

  .site-footer--with-filing {
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-bottom: max(env(safe-area-inset-bottom), calc(var(--footer-bottom-offset) - 1rem));
    text-align: left;
  }

  .site-footer a {
    color: inherit;
  }
</style>
